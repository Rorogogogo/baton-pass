#!/usr/bin/env bash
# Manage per-session handoff-baton state.
#   hb-state extend  <session_id> <new_threshold>
#   hb-state disable <session_id>
#   hb-state reset   <session_id>
set -euo pipefail

# Resolve our real location even when invoked via a symlink (e.g. ~/.local/bin).
_src="${BASH_SOURCE[0]}"
while [ -L "$_src" ]; do
  _dir="$(cd -P "$(dirname "$_src")" && pwd)"
  _src="$(readlink "$_src")"
  [ "${_src#/}" = "$_src" ] && _src="$_dir/$_src"
done
REPO_ROOT="$(cd -P "$(dirname "$_src")/.." && pwd)"
DATA_DIR="${HANDOFF_BATON_DATA:-$REPO_ROOT}"
ACTION="${1:-}"
SESSION="${2:-}"

if [[ -z "$ACTION" || -z "$SESSION" ]]; then
  echo "usage: hb-state {extend <session> <value>|disable <session>|reset <session>}" >&2
  exit 1
fi

STATE_DIR="$DATA_DIR/state"
mkdir -p "$STATE_DIR"
FILE="$STATE_DIR/$SESSION.json"

python3 - "$ACTION" "$FILE" "${3:-}" <<'PY'
import json, os, sys
action, file, val = sys.argv[1], sys.argv[2], sys.argv[3]
d = json.load(open(file)) if os.path.exists(file) else {}
if action == "extend":
    d["threshold_override"] = int(val)
elif action == "disable":
    d["disabled"] = True
elif action == "reset":
    d = {}
else:
    print(f"unknown action: {action}", file=sys.stderr)
    sys.exit(1)
json.dump(d, open(file, "w"))
print(f"handoff-baton: {action} ok ({file})")
PY
